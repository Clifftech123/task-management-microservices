{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "user-route": {
        "ClusterId": "user-cluster",
        "Match": {
          "Path": "/user/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "project-route": {
        "ClusterId": "project-cluster",
        "Match": {
          "Path": "/api/projects/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/projectservice-api" }
        ]
      }
    },
    "Clusters": {
      "user-cluster": {
        "Destinations": {
          "userDestination": {
            "Address": "https://localhost:7159"
          }
        }
      },
      "project-cluster": {
        "Destinations": {
          "projectDestination": {
            "Address": "https://localhost:7181"
          }
        }
      }
    }
  }
}
